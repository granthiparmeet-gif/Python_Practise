# Copy to secrets/config.env (gitignored). Same keys as .env.example.

# Dynadot (primary account → GMAIL_DEFAULT_MAILBOX)
DYNADOT_API_KEY=
DYNADOT_SECRET_KEY=
DYNADOT_BASE_URL=https://api.dynadot.com

# Extra Dynadot accounts: mailbox=apiKey (comma-separated)
# DYNADOT_API_KEYS=secondary@example.com=KEY,third@example.com=KEY
# DYNADOT_API_KEY_ACCOUNT=

NAMESILO_API_KEY=
NAMESILO_BASE_URL=https://www.namesilo.com/api

SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_BASE_URL=https://spaceship.dev/api

UD_MCP_API_KEY=
UD_API_BASE_URL=https://api.unstoppabledomains.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/auth/google/callback

GMAIL_SCAN_LIMIT=150
GMAIL_MESSAGE_CONCURRENCY=8
GMAIL_DOMAIN_MESSAGE_LIMIT=25
GMAIL_DOMAIN_CONCURRENCY=4
GMAIL_WIDE_MESSAGE_LIMIT=200

# GMAIL_MAILBOXES=primary@example.com:Primary,secondary@example.com:Secondary
# GMAIL_DEFAULT_MAILBOX=primary@example.com
# REGISTRAR_ACCOUNT_MAP=seller-one:primary@example.com,secondary:secondary@example.com

PORT=3001
SECRETS_DIR=secrets
