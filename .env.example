# Copy this file to .env and fill in your real values.

# Dynadot
DYNADOT_API_KEY=
DYNADOT_SECRET_KEY=
DYNADOT_BASE_URL=https://api.dynadot.com

# NameSilo
NAMESILO_API_KEY=
NAMESILO_BASE_URL=https://www.namesilo.com/api

# Sav
SAV_API_KEY=
SAV_BASE_URL=https://api.sav.com

# Spaceship
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_BASE_URL=https://spaceship.dev/api

# Unstoppable Domains
UD_MCP_API_KEY=
UD_API_BASE_URL=https://api.unstoppabledomains.com

# Gmail / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GMAIL_QUERY_FILTERS=dynadot.com,namesilo.com,porkbun.com,sav.com

# App
PORT=3001
