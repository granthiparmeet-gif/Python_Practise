# Prefer editing secrets/config.env (all API keys in one place).
# Copy this file to: secrets/config.env
# Root .env is optional override / legacy.

# --- Move to another PC ---
#   npm run pack:secrets -- --with-db
# Copy the secrets-bundle folder privately, then restore (see RESTORE.txt).
#   npm run doctor     # confirm keys without printing them

# Dynadot (primary account → GMAIL_DEFAULT_MAILBOX)
DYNADOT_API_KEY=
DYNADOT_SECRET_KEY=
DYNADOT_BASE_URL=https://api.dynadot.com

# Extra Dynadot accounts bound to Gmail mailboxes (add as many as you want):
# DYNADOT_API_KEYS=letsliterate@gmail.com=KEY,third@gmail.com=KEY
# Legacy alias still works:
# DYNADOT_API_KEY_LETSLITERATE=
# DYNADOT_SECRET_KEY_LETSLITERATE=

# NameSilo
NAMESILO_API_KEY=
NAMESILO_BASE_URL=https://www.namesilo.com/api

# Spaceship
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_BASE_URL=https://spaceship.dev/api

# Unstoppable Domains
UD_MCP_API_KEY=
UD_API_BASE_URL=https://api.unstoppabledomains.com

# Default Google OAuth (fallback if no secrets/gmail/<email>.json)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/auth/google/callback

# Per-mailbox Google OAuth JSON files (preferred):
#   secrets/gmail/you@gmail.com.json
# Format:
#   { "email":"...", "client_id":"...", "client_secret":"...", "redirect_uri":"http://127.0.0.1:3001/auth/google/callback" }

GMAIL_SCAN_LIMIT=150
GMAIL_MESSAGE_CONCURRENCY=8
GMAIL_DOMAIN_MESSAGE_LIMIT=25
GMAIL_DOMAIN_CONCURRENCY=4
GMAIL_WIDE_MESSAGE_LIMIT=200

# Mailboxes — source of truth for extra Gmails. Alias is the UI tab name.
# GMAIL_MAILBOXES=parmeetsgranthi@gmail.com:Parmeet,letsliterate@gmail.com:Nainjeet,third@gmail.com:Third
# GMAIL_MAILBOX_ALIASES=parmeetsgranthi@gmail.com=Parmeet,letsliterate@gmail.com=Nainjeet
# GMAIL_DEFAULT_MAILBOX=parmeetsgranthi@gmail.com
# GMAIL_SYNC_HISTORIC=1

# Dynadot "(account foo)" / push mail → which Gmail owns the name
# REGISTRAR_ACCOUNT_MAP=parmeet5:parmeetsgranthi@gmail.com,letsliterate:letsliterate@gmail.com

PORT=3001
SECRETS_DIR=secrets

# Connect inboxes:
#   npm run gmail:setup
#   npm run gmail:setup -- letsliterate@gmail.com
#   npm run gmail:setup -- third@gmail.com
